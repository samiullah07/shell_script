check_disk() {
  disk_usage=$(df -h / | awk 'NR==2 {gsub("%","",$5); print $5}');   disk_usage_int=$disk_usage;    if [ "$disk_usage_int" -gt 95 ]; then     color="$RED";     level="CRITICAL";   elif [ "$disk_usage_int" -gt 85 ]; then     color="$YELLOW";     level="WARNING";   else     color="$GREEN";     level="OK";   fi;    msg="Disk usage (/): ${disk_usage_int}%";   echo -e "${color}${msg}${NC}";   log_msg "$level" "$msg"; }
